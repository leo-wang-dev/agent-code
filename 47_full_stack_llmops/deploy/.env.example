# 复制为 .env 并填入真实值（对应文章第 47 篇 四、启动命令）
# 生成随机密钥：openssl rand -hex 32
DB_PASSWORD=change-me-16-hex
JWT_SECRET=change-me-32-hex
LANGFUSE_SECRET=change-me-32-hex
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# 微信公众号
WECHAT_TOKEN=your-wechat-token
WECHAT_APPID=wx...
WECHAT_AESKEY=43-char-encoding-aes-key

# 企业微信
WECOM_TOKEN=your-wecom-token
WECOM_AESKEY=43-char-encoding-aes-key
WECOM_CORP_ID=ww...
